PORT=5000

PGHOST=localhost
PGPORT=5432
PGDATABASE=famina_dev
PGUSER=famina_app
PGPASSWORD=replace-with-a-local-development-password
PGPOOL_MAX=5
# Use false for local PostgreSQL. Set true for a production database that uses TLS.
DATABASE_SSL=false

# Replace these local origins with your deployed storefront origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
# In production, point this at a persistent mounted directory for product uploads.
# UPLOADS_DIR=/var/lib/famina/uploads

ADMIN_USERNAME=replace-with-admin-username
# Production startup requires an admin password of at least 24 characters.
ADMIN_PASSWORD=replace-with-a-long-random-password
