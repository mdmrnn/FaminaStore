# Set to the API origin in local development or when frontend and API use separate hosts.
# For deployment, replace this with the public backend API origin.
# Leave empty in production when a reverse proxy serves the API on the same origin.
VITE_API_BASE_URL=http://localhost:5000
# Optional public support email used by the contact page.
VITE_CONTACT_EMAIL=
# Optional public support phone shown on the contact page.
VITE_CONTACT_PHONE=
